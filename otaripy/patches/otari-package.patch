+# Where an installed gateway finds its Alembic chain. The chain lives beside
+# src/ in the repository, not inside the gateway package, so only a source
+# checkout has it at a path derivable from this file. An install that ships the
+# chain elsewhere (a Nix store path, a distro package) names it here.
+MIGRATIONS_DIR_ENV = "OTARI_MIGRATIONS_DIR"
+
+
+def migrations_dir() -> Path:
+    """Return the directory holding ``env.py`` and ``versions/`` of otari's Alembic chain.
+
+    ``OTARI_MIGRATIONS_DIR`` when set, otherwise the ``alembic/`` directory of
+    the source checkout this module was imported from.
+
+    Raises:
+        RuntimeError: ``OTARI_MIGRATIONS_DIR`` names a directory without an ``env.py``.
+
+    """
+    configured = os.environ.get(MIGRATIONS_DIR_ENV)
+    if configured:
+        directory = Path(configured)
+        if not (directory / "env.py").is_file():
+            msg = f"{MIGRATIONS_DIR_ENV}={configured} holds no env.py, so it is not otari's Alembic chain."
+            raise RuntimeError(msg)
+        return directory
+    return Path(__file__).resolve().parents[3] / "alembic"
+
